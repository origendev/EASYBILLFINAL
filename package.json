{
  "name": "easybill-desktop",
  "version": "1.0.1",
  "description": "EasyBill billing and point-of-sale desktop application",
  "author": "EasyBill",
  "main": "electron/main.cjs",
  "private": true,

  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },

  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },

  "dependencies": {
    "electron-updater": "^6.8.9"
  },

  "build": {
    "appId": "com.easybill.desktop",
    "productName": "EasyBill",

    "directories": {
      "output": "release"
    },

    "files": [
      "electron/**/*",
      "index.html",
      "css/**/*",
      "js/**/*",
      "!js/**/.*"
    ],

    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "EasyBill-Setup-${version}.${ext}"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EasyBill"
    },

    "publish": {
      "provider": "github",
      "owner": "origendev",
      "repo": "EASYBILLFINAL"
    }
  }
}